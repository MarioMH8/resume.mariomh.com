{
	"name": "resume.mariomh.com",
	"version": "0.0.0",
	"author": "MarioMH <dev@mariomh.com>",
	"description": "Curriculum Vitae imprimible de MarioMH",
	"keywords": [
		"curriculum",
		"vitae",
		"resume",
		"portfolio",
		"astro",
		"tailwind"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MarioMH8/resume.mariomh.com.git"
	},
	"homepage": "https://resume.mariomh.com",
	"bugs": {
		"url": "https://github.com/MarioMH8/resume.mariomh.com/issues"
	},
	"license": "PRIVATE",
	"private": true,
	"type": "module",
	"workspaces": [
		"resume"
	],
	"scripts": {
		"build": "bun run build:packages && astro build",
		"build:packages": "bun run --filter '@mariomh8/resume' build",
		"build:resume": "bun run build:packages",
		"check:packages": "bun run build:packages && bun run lint:packages",
		"commitlint": "commitlint --edit",
		"dev": "astro dev",
		"lint": "eslint .",
		"lint:ci": "eslint --cache --cache-strategy content .",
		"lint:fix": "eslint --cache --fix .",
		"lint:packages": "bun run --filter '@mariomh8/resume' lint:packages",
		"postinstall": "astro sync",
		"prepare": "husky",
		"start": "astro preview",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"typecheck:astro": "astro check"
	},
	"dependencies": {
		"@fontsource/dm-sans": "5.3.0",
		"@lucide/astro": "1.70.0",
		"@mariomh8/archia": "0.1.0",
		"@mariomh8/font": "0.2.0",
		"@mariomh8/heading": "0.3.0",
		"@mariomh8/paragraph": "0.3.0",
		"@mariomh8/resume": "workspace:*",
		"@mariomh8/span": "0.3.0",
		"@mariomh8/tailwind": "0.3.0",
		"astro": "7.4.8",
		"astro-mail-obfuscation": "3.0.1",
		"astro-seo": "1.2.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/ts-plugin": "1.10.12",
		"@changesets/cli": "3.0.3",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@hexadrop/eslint-config": "1.3.1",
		"@hexadrop/tsconfig": "0.0.5",
		"@playform/compress": "0.2.5",
		"@tailwindcss/vite": "4.3.5",
		"@types/bun": "1.4.4",
		"astro-robots-txt": "1.0.0",
		"astro-webmanifest": "1.0.0",
		"eslint": "10.14.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"sharp": "0.35.5",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3"
	},
	"packageManager": "bun@1.4.4"
}
