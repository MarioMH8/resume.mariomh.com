{
	"name": "resume.mariomh.com",
	"version": "0.0.0",
	"author": "MarioMH <dev@mariomh.com>",
	"description": "Curriculum Vitae imprimible de MarioMH",
	"keywords": [
		"curriculum",
		"vitae",
		"resume",
		"portfolio",
		"astro",
		"tailwind"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MarioMH8/resume.mariomh.com.git"
	},
	"homepage": "https://resume.mariomh.com",
	"bugs": {
		"url": "https://github.com/MarioMH8/resume.mariomh.com/issues"
	},
	"license": "PRIVATE",
	"private": true,
	"type": "module",
	"workspaces": [
		"resume"
	],
	"scripts": {
		"build": "bun run --filter '@mariomh/resume' build && astro build",
		"build:resume": "bun run --filter '@mariomh/resume' build",
		"dev": "astro dev",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"postinstall": "astro sync",
		"start": "astro preview",
		"test": "bun test",
		"typecheck": "astro check & tsc --noEmit"
	},
	"dependencies": {
		"@fontsource/dm-sans": "5.2.8",
		"@mariomh/archia": "0.0.4",
		"@mariomh/font": "0.0.10",
		"@mariomh/heading": "0.0.14",
		"@mariomh/paragraph": "0.0.13",
		"@mariomh/resume": "workspace:*",
		"@mariomh/span": "0.0.13",
		"@mariomh/tailwind": "0.0.12",
		"astro": "5.16.6",
		"astro-seo": "0.8.4",
		"lucide-astro": "0.556.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.6",
		"@astrojs/sitemap": "3.6.0",
		"@astrojs/ts-plugin": "1.10.6",
		"@changesets/cli": "2.30.0",
		"@hexadrop/eslint-config": "0.1.15",
		"@hexadrop/tsconfig": "0.0.5",
		"@playform/compress": "0.2.1",
		"@tailwindcss/vite": "4.2.1",
		"@types/bun": "1.3.10",
		"astro-mail-obfuscation": "2.3.4",
		"astro-robots-txt": "1.0.0",
		"astro-webmanifest": "1.0.0",
		"eslint": "9.39.4",
		"sharp": "0.34.5",
		"tailwindcss": "4.2.1",
		"typescript": "5.9.3",
		"vite-tsconfig-paths": "6.1.1"
	}
}
