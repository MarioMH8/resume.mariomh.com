{
	"name": "@mariomh/resume",
	"version": "0.0.5",
	"author": "MarioMH <dev@mariomh.com>",
	"description": "Curriculum Vitae de MarioMH",
	"keywords": [
		"curriculum",
		"vitae",
		"resume"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MarioMH8/resume.mariomh.com.git",
		"directory": "resume"
	},
	"homepage": "https://resume.mariomh.com",
	"bugs": {
		"url": "https://github.com/MarioMH8/resume.mariomh.com/issues"
	},
	"license": "PRIVATE",
	"type": "module",
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": "./dist/index.js"
		},
		"./package.json": {
			"default": "./package.json"
		},
		"./resume.json": {
			"default": "./dist/resume.json"
		},
		"./schema.json": {
			"default": "./dist/resume.json"
		}
	},
	"scripts": {
		"build": "tsup",
		"lint:packages": "publint",
		"prepublishOnly": "tsup && publint"
	},
	"devDependencies": {
		"publint": "0.3.18",
		"tsup": "8.5.1",
		"zod": "4.3.6",
		"zod-to-ts": "2.1.0"
	}
}
