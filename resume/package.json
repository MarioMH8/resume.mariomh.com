{
	"name": "@mariomh/resume",
	"version": "0.0.0",
	"author": "MarioMH <dev@mariomh.com>",
	"description": "Curriculum Vitae de MarioMH",
	"keywords": [
		"curriculum",
		"vitae",
		"resume"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MarioMH8/resume.mariomh.com.git",
		"directory": "resume"
	},
	"homepage": "https://resume.mariomh.com",
	"bugs": {
		"url": "https://github.com/MarioMH8/resume.mariomh.com/issues"
	},
	"license": "PRIVATE",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": {
			"default": "./package.json"
		},
		"./resume.json": {
			"default": "./dist/resume.json"
		},
		"./schema.json": {
			"default": "./dist/resume.json"
		}
	},
	"scripts": {
		"build": "tsup",
		"lint:packages": "publint",
		"prepublishOnly": "tsup && publint"
	},
	"devDependencies": {
		"@duplojs/zod-to-typescript": "0.3.0",
		"publint": "0.3.3",
		"tsup": "8.3.6",
		"zod": "3.24.2",
		"zod-to-json-schema": "3.24.1"
	}
}
