{
	"name": "@mariomh8/resume",
	"version": "0.1.0",
	"author": "MarioMH <dev@mariomh.com>",
	"description": "Curriculum Vitae de MarioMH",
	"keywords": [
		"curriculum",
		"vitae",
		"resume"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MarioMH8/resume.mariomh.com.git",
		"directory": "resume"
	},
	"homepage": "https://resume.mariomh.com",
	"bugs": {
		"url": "https://github.com/MarioMH8/resume.mariomh.com/issues"
	},
	"license": "PRIVATE",
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"CHANGELOG.md",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./package.json": {
			"default": "./package.json"
		},
		"./resume.json": {
			"default": "./dist/resume.json"
		},
		"./schema.json": {
			"default": "./dist/schema.json"
		}
	},
	"scripts": {
		"build": "tsdown && bun run build:assets",
		"build:assets": "bun run scripts/build-assets.ts",
		"lint:packages": "publint",
		"test": "bun test"
	},
	"devDependencies": {
		"publint": "0.3.25",
		"tsdown": "0.23.7",
		"typescript": "6.0.3",
		"zod": "4.6.7",
		"zod-to-ts": "2.1.0"
	}
}
