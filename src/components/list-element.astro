---
import Link from '@components/link.astro';
import Span from '@mariomh/span/astro';
import type { HTMLTag, Polymorphic } from 'astro/types';

type Props<Tag extends HTMLTag = 'li'> = Polymorphic<{ as: Tag }> & {
	time?: number | string | undefined;
	title: string;
	description?: string | undefined;
	url?: string | undefined;
};

const { class: cls, 'class:list': clsList, description, time, title, url, ...properties } = Astro.props;
---

<li
	{...properties}
	class:list={[
		'flex flex-row print:flex-col gap-4 print:gap-0',
		'[&>svg]:size-5 [&>svg]:my-0.5 [&>svg]:shrink-0 [&>svg]:print:hidden',
		cls,
		clsList,
	]}>
	<slot name='icon' />
	{
		time && time !== 0 && (
			<Span
				as='time'
				class='not-print:order-last shrink-0'
				dimension='sm'
				variant='muted'>
				{time}
			</Span>
		)
	}
	<div class='w-full flex flex-col'>
		<span class='flex flec-row items-center gap-2'>
			{
				url ? (
					<Link
						class='w-fit'
						href={url}
						rel='noopener noreferrer'
						target='_blank'
						title={`Ver ${title}`}>
						{title}
					</Link>
				) : (
					<Span class='font-primary'>{title}</Span>
				)
			}
			<slot name='badge' />
		</span>
		{
			description && (
				<Span
					class='print:text-sm'
					variant='muted'>
					{description}
				</Span>
			)
		}
		<slot />
	</div>
</li>
