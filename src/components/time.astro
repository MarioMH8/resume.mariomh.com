---
import type { HTMLTag, Polymorphic } from 'astro/types';

import type { DateType } from './time';
import dateFunction from './time';

type Props<Tag extends HTMLTag = 'time'> = Polymorphic<{ as: Tag }> & {
	date: [DateType | undefined, DateType | undefined] | (DateType | undefined);
	format?: 'year' | 'year-month';
};

const { as: Tag = 'time', class: cls, 'class:list': clsList, date, format = 'year', ...properties } = Astro.props;

const array = Array.isArray(date) ? date : [date];
const formattedArray = array
	.filter((d): d is DateType => d !== undefined)
	.map(d => dateFunction(d, format))
	.filter(Boolean);
---

{formattedArray.length === 1 ? (
	<Tag
		{...properties}
		data-title={formattedArray[0]}
		datetime={formattedArray[0]}>
		{formattedArray[0]}
	</Tag>
) : (
	formattedArray.length === 2 && (
		<Fragment>
			<Tag
				{...properties}
				data-title={formattedArray[0]}
				datetime={formattedArray[0]}>
				{formattedArray[0]}
			</Tag>
			{' - '}
			<Tag
				{...properties}
				data-title={formattedArray[1]}
				datetime={formattedArray[1]}>
				{formattedArray[1]}
			</Tag>
		</Fragment>
	)
)}
