---
import Section from '@components/section.astro';
import Paragraph from '@mariomh/paragraph/astro';
import resume from '@resume';

const { summary } = resume.basics ?? {};
---

{
	summary && (
		<Section
			class='print:mt-1 print:col-span-4'
			title='Sobre mi'>
			<Paragraph
				class='m-0 print:text-sm'
				variant='muted'>
				{summary}
			</Paragraph>
		</Section>
	)
}
