---
import List from '@components/list.astro';
import ListElement from '@components/list-element.astro';
import Section from '@components/section.astro';
import resume from '@mariomh/resume';
import { Trophy } from 'lucide-astro';

const { awards } = resume ?? {};
---

{
	awards && awards.length > 0 && (
		<Section
			class='print:hidden'
			title='Premios'>
			<List>
				{awards.map(({ awarder, date, summary, title }) => {
					if (!title) return undefined;

					const year = date ? new Date(date).getFullYear() : undefined;
					const description = [awarder, summary].filter(Boolean).join(' - ');

					return (
						<ListElement
							description={description}
							time={year}
							title={title}>
							<Trophy slot='icon' />
						</ListElement>
					);
				})}
			</List>
		</Section>
	)
}
