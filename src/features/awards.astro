---
import List from '@components/list.astro';
import ListElement from '@components/list-element.astro';
import Section from '@components/section.astro';
import { Trophy } from 'lucide-astro';
import { awards } from 'resume';
---

{
	awards && awards.length > 0 && (
		<Section
			class='print:hidden'
			title='Premios'>
			<List>
				{awards.map(({ awarder, date, summary, title }) => {
					const year = new Date(date).getFullYear();
					const description = `${awarder} - ${summary}`;

					return (
						<ListElement
							description={description}
							time={year}
							title={title}>
							<Trophy slot='icon' />
						</ListElement>
					);
				})}
			</List>
		</Section>
	)
}
