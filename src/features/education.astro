---
import List from '@components/list.astro';
import ListElement from '@components/list-element.astro';
import Section from '@components/section.astro';
import SectionHeading from '@components/section-heading.astro';
import Heading from '@mariomh/heading/astro';
import Span from '@mariomh/span/astro';
import resume from '@resume';
import { GraduationCap, Languages, ScrollText } from 'lucide-astro';

const { certificates, education, languages } = resume ?? {};

const hasEducation = Boolean(education && education.length > 0);
const hasCertificates = Boolean(certificates && certificates.length > 0);
const hasLanguages = Boolean(languages && languages.length > 0);
const hasCertificatesOrLanguages = hasCertificates || hasLanguages;

const hasAnyEduction = hasEducation || hasCertificatesOrLanguages;
---

{
	hasAnyEduction && (
		<Section
			class='order-first'
			title='Educación'>
			<List>
				{education?.map(({ area, courses, endDate, institution, score, startDate, studyType, url }) => {
					if (!institution) {
						return <Fragment />;
					}

					const description = [area, studyType].filter(Boolean).join(' - ');
					const badge = score ? `Nota: ${score}` : undefined;
					const badgeAriaLabel = `Nota de ${institution}`;

					return (
						<ListElement
							description={description}
							time={[startDate, endDate]}
							title={institution}
							url={url}>
							<GraduationCap slot='icon' />
							{score && (
								<Span
									aria-label={badgeAriaLabel}
									class='print:hidden'
									dimension='xs'
									slot='badge'
									variant='muted'>
									{badge}
								</Span>
							)}
							{courses && courses.length > 0 && (
								<Fragment>
									<Heading
										as='span'
										class='mt-2 print:hidden'
										heading='h5'
										subtitle>
										Asignaturas
									</Heading>
									<ul class='print:hidden list-disc ml-4 space-y-2'>
										{courses.map(course => {
											return (
												<Span
													as='li'
													dimension='sm'
													variant='muted'>
													{course}
												</Span>
											);
										})}
									</ul>
								</Fragment>
							)}
						</ListElement>
					);
				})}
			</List>
			{certificates && certificates.length > 0 && (
				<>
					<SectionHeading
						class='text-lg print:text-lg mt-4 print:mb-1'
						heading='h4'>
						Certificados
					</SectionHeading>
					<List>
						{certificates.map(({ date, issuer, name, url }) => {
							if (!name) {
								return <Fragment />;
							}

							return (
								<ListElement
									description={issuer}
									time={date}
									title={name}
									url={url}>
									<ScrollText slot='icon' />
								</ListElement>
							);
						})}
					</List>
				</>
			)}
			{languages && languages.length > 0 && (
				<>
					<SectionHeading
						class='text-lg print:text-lg mt-4 print:mb-1'
						heading='h4'>
						Idiomas
					</SectionHeading>
					<List>
						{languages.map(({ fluency, language }) => {
							if (!language) {
								return <Fragment />;
							}

							return (
								<ListElement
									description={fluency}
									title={language}>
									<Languages slot='icon' />
								</ListElement>
							);
						})}
					</List>
				</>
			)}
		</Section>
	)
}
