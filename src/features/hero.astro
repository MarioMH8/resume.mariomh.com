---
import me from '@assets/me.png';
import Section from '@components/section.astro';
import { LinkedinIcon, SOCIAL_ICONS } from '@icons';
import Heading from '@mariomh/heading/astro';
import resume from '@mariomh/resume';
import Span from '@mariomh/span/astro';
import { Image } from 'astro:assets';
import { Download, Globe, Link, Mail, MapPin, Phone } from 'lucide-astro';

const { email, image, label, location, name, phone, profiles, url } = resume.basics ?? {};

const linkedInfo = profiles?.find(({ network }) => network === 'LinkedIn');
const linkedUrl = linkedInfo?.url?.replace('https://', '');
const portfolioUrl = url?.replace('https://', '');

const locationCompose = [location?.city, location?.region].filter(Boolean).join(', ');

const printLinks = Boolean(portfolioUrl || email || phone || linkedUrl);
const notPrintLinks = Boolean(url || email || phone || profiles?.length);
const hero = Boolean(name || label || locationCompose || printLinks || notPrintLinks);
const print = Boolean(hero || image);
---

{
	print && (
		<Section class='print:col-span-8'>
			<div
				class:list={[
					'flex gap-8 not-print:flex-wrap-reverse not-print:justify-end not-print:items-start not-print:flex-row-reverse xl:not-print:flex-col-reverse xl:not-print:items-end',
					'print:flex-row-reverse print:gap-12',
				]}>
				{hero && (
					<div class='flex flex-col gap-1 pr-8 print:gap-0 print:pr-0'>
						{name && (
							<Heading
								class='mb-0 text-3xl print:text-2xl'
								heading='h1'
								weight='bold'>
								{name}
							</Heading>
						)}
						{label && (
							<Heading
								class='mb-0 text-lg print:text-base'
								heading='h2'
								subtitle
								weight='base'>
								{label}
							</Heading>
						)}
						{locationCompose && (
							<Span
								class='flex items-center gap-2 pt-2'
								dimension='sm'
								variant='muted'>
								<MapPin class='w-3 h-3' />
								{locationCompose}
							</Span>
						)}
						{printLinks && (
							<footer class='not-print:hidden flex flex-wrap flex-row gap-x-4'>
								{portfolioUrl && url && (
									<Span
										as='a'
										class='flex items-center gap-2 pt-2'
										dimension='sm'
										href={url}
										title='Visitar portafolio'
										variant='muted'>
										<Globe class='w-3 h-3' />
										{portfolioUrl}
									</Span>
								)}
								{email && (
									<Span
										as='a'
										class='flex items-center gap-2 pt-2'
										dimension='sm'
										href={`mailto:${email}`}
										title='Enviar correo'
										variant='muted'>
										<Mail class='w-3 h-3' />
										{email}
									</Span>
								)}

								{phone && (
									<Span
										as='a'
										class='flex items-center gap-2 pt-2'
										dimension='sm'
										href={`tel:${phone}`}
										title='Llamar por teléfono'
										variant='muted'>
										<Phone class='w-3 h-3' />
										{phone}
									</Span>
								)}
								{linkedUrl && (
									<Span
										as='a'
										class='flex items-center gap-2 pt-2'
										dimension='sm'
										href={linkedUrl}
										title='Visitar perfil de LinkedIn'
										variant='muted'>
										<LinkedinIcon class='w-3 h-3' />
										{linkedUrl}
									</Span>
								)}
							</footer>
						)}
						{notPrintLinks && (
							<footer class='print:hidden mt-2 flex gap-1 text-sm'>
								{url && (
									<a
										class:list={[
											'size-8',
											'inline-flex items-center justify-center rounded-md p-1',
											'text-primary-foreground-highlight dark:text-primary',
											'hover:bg-primary hover:text-primary-foreground dark:hover:text-primary-foreground',
											'transition-all duration-300 ease-linear',
										]}
										href={url}
										rel='noopener noreferrer'
										target='_blank'
										title='Visitar portafolio'>
										<Globe class='w-4.5 h-4.5' />
									</a>
								)}
								{email && (
									<a
										class:list={[
											'size-8',
											'inline-flex items-center justify-center rounded-md p-1',
											'text-primary-foreground-highlight dark:text-primary',
											'hover:bg-primary hover:text-primary-foreground dark:hover:text-primary-foreground',
											'transition-all duration-300 ease-linear',
										]}
										href={`mailto:${email}`}
										rel='noopener noreferrer'
										target='_blank'
										title='Enviar correo'>
										<Mail class='w-4.5 h-4.5' />
									</a>
								)}
								{phone && (
									<a
										class:list={[
											'size-8',
											'inline-flex items-center justify-center rounded-md p-1',
											'text-primary-foreground-highlight dark:text-primary',
											'hover:bg-primary hover:text-primary-foreground dark:hover:text-primary-foreground',
											'transition-all duration-300 ease-linear',
										]}
										href={`tel:${phone}`}
										rel='noopener noreferrer'
										target='_blank'
										title='Llamar por teléfono'>
										<Phone class='w-4.5 h-4.5' />
									</a>
								)}
								{profiles?.map(({ network, url }) => {
									if (!url) {
										return <Fragment />;
									}

									const Icon = SOCIAL_ICONS[network ?? ''] ?? Link;

									return (
										<a
											class:list={[
												'size-8',
												'inline-flex items-center justify-center rounded-md p-1',
												'text-primary-foreground-highlight dark:text-primary',
												'hover:bg-primary hover:text-primary-foreground dark:hover:text-primary-foreground',
												'transition-all duration-300 ease-linear',
											]}
											href={url}
											rel='noopener noreferrer'
											target='_blank'
											title={network ? `Visitar perfil de ${network}` : 'Visitar perfil'}>
											<Icon class='w-4.5 h-4.5' />
										</a>
									);
								})}
								<a
									class:list={[
										'size-8',
										'inline-flex items-center justify-center rounded-md p-1',
										'text-primary-foreground-highlight dark:text-primary',
										'hover:bg-primary hover:text-primary-foreground dark:hover:text-primary-foreground',
										'transition-all duration-300 ease-linear',
									]}
									href='/resume.pdf'
									title='Descargar currículum'>
									<Download class='w-4.5 h-4.5' />
								</a>
							</footer>
						)}
					</div>
				)}
				{image && (
					<Image
						alt={name ?? label ?? ''}
						class:list={[
							'w-fit max-w-48 relative xl:ml-[10%]',
							'after:absolute after:block after:left-0 after:right-0 after:bottom-0 after:z-1 after:h-2',
							'print:max-w-[130px]',
						]}
						src={me}
						style='mask-image: linear-gradient(to bottom, black 98%, transparent 100%);'
					/>
				)}
			</div>
		</Section>
	)
}
