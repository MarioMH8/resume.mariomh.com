---
import List from '@components/list.astro';
import ListElement from '@components/list-element.astro';
import Section from '@components/section.astro';
import { INTEREST_ICONS } from '@icons';
import resume from '@mariomh/resume';

const { interests } = resume ?? {};
---

{
	interests && interests.length > 0 && (
		<Section
			class='print:hidden space-y-6'
			title='Aficiones'>
			<List>
				{interests.map(({ keywords, name }) => {
					if (!name) {
						return <Fragment />;
					}

					const description = keywords?.join(' • ');
					const Icon = INTEREST_ICONS[name];

					return (
						<ListElement
							description={description}
							title={name}>
							{Icon && <Icon slot='icon' />}
						</ListElement>
					);
				})}
			</List>
		</Section>
	)
}
