---
import Article from '@components/article.astro';
import Link from '@components/link.astro';
import Paragraph from '@mariomh/paragraph/astro';
import type { Publication } from '@mariomh/resume';
import Span from '@mariomh/span/astro';
import { Pencil } from 'lucide-astro';

import Time from '../components/time.astro';

interface Props {
	publication: Publication;
}

const { publication } = Astro.props;
const { name, publisher, releaseDate, summary, url } = publication;
---

<Article class='space-y-2'>
	<header class='flex items-center justify-between space-x-2'>
		<div class='flex items-center gap-2'>
			<Pencil
				aria-hidden='true'
				class='size-4'
			/>
			{
				url ? (
					<Link
						href={url}
						rel='noopener noreferrer'
						target='_blank'
						title={`Ver ${name}`}>
						{name}
					</Link>
				) : (
					<Span class='font-primary'>{name}</Span>
				)
			}
		</div>
	</header>
	{
		summary && (
			<Paragraph
				class='mb-2'
				dimension='sm'>
				{summary}
			</Paragraph>
		)
	}
	{
		(releaseDate || publisher) && (
			<Span
				as='footer'
				dimension='sm'
				variant='muted'>
				<Time date={releaseDate} />
				{releaseDate && publisher && ' - '}
				{publisher}
			</Span>
		)
	}
</Article>
