---
import Article from '@components/article.astro';
import Link from '@components/link.astro';
import Paragraph from '@mariomh/paragraph/astro';
import cv from '@mariomh/resume';
import Span from '@mariomh/span/astro';
import { Pencil } from 'lucide-astro';

type Publication = (typeof cv.publications)[number];

interface Props {
	publication: Publication;
}
const { publication } = Astro.props;
const { name, publisher, releaseDate, summary, url } = publication;
const year = releaseDate ? new Date(releaseDate).getFullYear() : undefined;

const footer = [year, publisher].filter(Boolean).join(' - ');
---

<Article>
	<header class='flex items-center justify-between space-x-2'>
		<div class='flex items-center gap-2'>
			<Pencil
				aria-hidden='true'
				class='size-4'
			/>
			<Link
				href={url}
				rel='noopener noreferrer'
				target='_blank'
				title={`Ver ${name}`}>
				{name}
			</Link>
		</div>
	</header>
	<Paragraph
		class='my-2'
		dimension='sm'>
		{summary}
	</Paragraph>
	<footer>
		{
			footer ? (
				<Span
					class='mt-2'
					dimension='sm'
					variant='muted'>
					{footer}
				</Span>
			) : undefined
		}
	</footer>
</Article>
