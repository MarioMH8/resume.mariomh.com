---
import Section from '@components/section.astro';
import Paragraph from '@mariomh/paragraph/astro';
import resume from '@mariomh/resume';
import Span from '@mariomh/span/astro';

const { references } = resume ?? {};
---

{
	references && references.length > 0 && (
		<Section
			class='print:hidden space-y-6'
			title='Referencias'>
			{references
				.filter(reference => reference.name)
				.map(({ name, reference }) => {
					return (
						<figure class='mb-0'>
							<Paragraph
								as='blockquote'
								class='mb-0'>
								{reference}
							</Paragraph>
							<Span
								as='figcaption'
								dimension='sm'
								variant='muted'>
								&mdash; {name}
							</Span>
						</figure>
					);
				})}
		</Section>
	)
}
