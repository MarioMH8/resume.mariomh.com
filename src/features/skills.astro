---
import Section from '@components/section.astro';
import SkillList from '@components/skill-list.astro';
import { skills } from '@mariomh/resume';
---

{
	skills && skills.length > 0 && (
		<Section
			class='print:hidden'
			title='Tecnologías'>
			<SkillList
				big
				skills={skills}
			/>
		</Section>
	)
}
