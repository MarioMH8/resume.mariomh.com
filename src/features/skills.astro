---
import Section from '@components/section.astro';
import SkillList from '@components/skill-list.astro';
import resume from '@mariomh/resume';

const { skills } = resume ?? {};

let filteredSkills = skills?.filter(skill => skill.name);
---

{
	filteredSkills && filteredSkills.length > 0 && (
		<Section
			class='print:hidden'
			title='Tecnologías'>
			<SkillList
				big
				skills={filteredSkills}
			/>
		</Section>
	)
}
