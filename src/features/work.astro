---
import Link from '@components/link.astro';
import SkillList from '@components/skill-list.astro';
import Time from '@components/time.astro';
import { CaretDownIcon } from '@icons';
import Heading from '@mariomh/heading/astro';
import Paragraph from '@mariomh/paragraph/astro';
import cn from '@mariomh/paragraph/class-name';
import Span from '@mariomh/span/astro';
import type { Work } from '@resume';

interface Props {
	work: Work;
}

const { work } = Astro.props;
const {
	achievements,
	endDate,
	location,
	location_type: locationType,
	name,
	position,
	responsibilities,
	skills,
	startDate,
	summary,
	url,
} = work;

const filterAchievements = Array.isArray(achievements)
	? (achievements.filter(Boolean).filter(achievement => typeof achievement === 'string') as string[])
	: undefined;
const filterResponsibilities = Array.isArray(responsibilities)
	? (responsibilities.filter(Boolean).filter(responsibility => typeof responsibility === 'string') as string[])
	: undefined;
const filterSkills = Array.isArray(skills)
	? (skills.filter(Boolean).filter(skill => typeof skill === 'string') as string[])
	: undefined;
const locationSubtitle = [location, locationType]
	.filter(Boolean)
	.filter(skill => typeof skill === 'string')
	.join(' - ');
const showResponsibilities = Boolean(filterResponsibilities && filterResponsibilities.length > 0);
const showAchievements = Boolean(filterAchievements && filterAchievements.length > 0);
const showContent = Boolean(summary || showAchievements || showResponsibilities);
const sameYear =
	startDate !== undefined &&
	endDate !== undefined &&
	new Date(startDate).getFullYear() === new Date(endDate).getFullYear();
const hidePrint = 'hidePrint' in work && work.hidePrint === true;
---

<li class='break-inside-avoid group/work'>
	<div
		class:list={[
			'relative',
			'grid',
			'print:grid-cols-1 md:grid-cols-10',
			'md:gap-8 lg:gap-6 print:gap-1',
			'lg:hover:!opacity-100',
			hidePrint && 'print:hidden',
		]}>
		<header
			class='relative text-sm mt-1 pr-4 font-medium md:not-print:text-right print:font-semibold md:col-span-2'>
			<Time date={startDate} />
			{startDate && !sameYear && ' - '}
			{endDate ? sameYear ? <Fragment /> : <Time date={endDate} /> : <span>Presente</span>}
		</header>
		<div
			class:list={[
				'relative md:col-span-8',
				'flex flex-col',
				'before:absolute print:before:hidden before:w-px before:-ml-6 before:mt-2',
				'group-not-last/work:before:h-[110%] group-not-last/work:before:lg:h-full group-last/work:before:h-[85%]',
				'before:bg-primary-foreground-highlight',
			]}>
			<div
				class:list={[
					'absolute print:hidden w-2 h-2 mt-2.5 -translate-x-[1.71rem]',
					'rounded-full',
					'bg-primary-foreground-highlight',
					'ring-4 ring-cv-background dark:ring-cv-dark-background',
				]}>
			</div>
			<Span
				aria-label='{position} @ {company}'
				as='h3'
				class='inline-flex items-center gap-2 font-primary w-fit'
				dimension='lg'
				weight='base'>
				{position && <span>{position}</span>}
				{position && '@'}
				{
					url ? (
						<Link
							href={url}
							rel='noopener noreferrer'
							target='_blank'
							title={`Ver ${name}`}
							variant='bright'>
							{name}
						</Link>
					) : (
						<span>{name}</span>
					)
				}
			</Span>
			{
				locationSubtitle && (
					<Span
						class='print:text-xs'
						dimension='sm'
						variant='muted'>
						{locationSubtitle}
					</Span>
				)
			}
			{
				showContent && (
					<div class='mt-4 mb-6 print:mt-2 print:mb-4 flex flex-col gap-3 print:gap-1'>
						{summary && (
							<div>
								<Heading
									class='text-base print:text-sm mb-0'
									heading='h4'>
									Resumen:
								</Heading>
								<Paragraph
									class='print:text-xs mb-0'
									dimension='sm'
									variant='muted'>
									{summary}
								</Paragraph>
							</div>
						)}
						{(showResponsibilities || showAchievements) && (
							<>
								<div
									class:list={[
										'relative',
										'flex flex-col gap-3 print:gap-1',
										'overflow-y-hidden',
										'data-expanded:max-h-fit not-data-expanded:max-h-12',
										`after:absolute after:content-[''] after:bottom-0 after:w-full after:h-12`,
										'after:bg-gradient-to-t',
										'after:from-cv-background after:to-cv-background/0',
										'dark:after:from-cv-dark-background dark:after:to-cv-dark-background/0',
										'max-md:!h-auto print:!max-h-fit print:after:hidden',
										'not-print:data-expanded:after:hidden',
									]}>
									{showResponsibilities && (
										<div>
											<Heading
												class='text-base print:text-sm mb-0'
												heading='h4'>
												Responsabilidades:
											</Heading>
											<ul
												class:list={cn(
													{ dimension: 'sm', variant: 'muted' },
													'print:text-xs mb-0 list-disc'
												)}>
												{filterResponsibilities?.map(r => (
													<li class='ml-4 marker:text-primary-foreground-highlight dark:marker:text-primary'>
														{r}
													</li>
												))}
											</ul>
										</div>
									)}
									{showAchievements && (
										<div>
											<Heading
												class='text-base print:text-sm mb-0'
												heading='h4'>
												Logros:
											</Heading>
											<ul
												class:list={cn(
													{ dimension: 'sm', variant: 'muted' },
													'print:text-xs mb-0 list-disc'
												)}>
												{filterAchievements?.map(r => (
													<li class='ml-4 marker:text-primary-foreground-highlight dark:marker:text-primary'>
														{r}
													</li>
												))}
											</ul>
										</div>
									)}
								</div>
								<button
									class:list={[
										'show-more',
										'print:hidden',
										'w-fit',
										'text-sm',
										'group/show-more',
										'flex flex-row justify-center items-center gap-1.5',
										'text-primary-foreground/65 dark:text-primary-dark-foreground/65',
										'hover:text-primary-foreground/85 hover:dark:text-primary-dark-foreground/85',
										'cursor-pointer underline transition-all hover:text-skin-base',
									]}>
									<span class='hidden group-not-data-expanded/show-more:inline'>Mostrar más</span>
									<span class='hidden group-data-expanded/show-more:inline'>Mostrar menos</span>
									<CaretDownIcon
										class:list={[
											'w-4 h-4',
											'transition-transform ease-out motion-reduce:transition-none',
											'group-hover/show-more:translate-y-0.5',
											'group-data-expanded/show-more:rotate-180',
										]}
									/>
								</button>
							</>
						)}
						{filterSkills && (
							<SkillList
								aria-label='Tecnologías utilizadas'
								class='print:hidden'
								skills={filterSkills}
							/>
						)}
					</div>
				)
			}
		</div>
	</div>
</li>

<script>
	const showMoreButtons = document.querySelectorAll('.show-more');
	showMoreButtons.forEach(button => {
		button.addEventListener('click', () => {
			button.previousElementSibling?.toggleAttribute('data-expanded');
			button.toggleAttribute('data-expanded');
		});
	});
</script>
